# ==========================================
# KnowledgeHub AI Environment Configuration
# ==========================================

# 1. Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/knowledgehub
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/knowledgehub

# 2. Supabase Configuration (Backend)
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_must_be_long_enough_for_hs256

# 3. Supabase Configuration (Frontend)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 4. Backend CORS & Routing
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8000

# 5. LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434

# 6. Demo Sandbox
DEMO_SANDBOX_PASSWORD=SecureDemoPassword123!
